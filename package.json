{
  "name": "obsbot-web-control",
  "version": "0.1.0",
  "description": "Remote PTZ web widget for OBSBot Tiny SE -- pairs with VDO.Ninja",
  "type": "module",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "postinstall": "node ./scripts/setup-obsbot-sdk.mjs"
  },
  "dependencies": {
    "express": "^4.21.2",
    "obsbot-sdk": "github:malko/obsbot-js-sdk",
    "tsx": "^4.19.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "@types/ws": "^8.5.13",
    "node-addon-api": "^7.1.0",
    "node-gyp": "^10.3.1",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=22.18.0",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.15.4",
  "pnpm": {
    "neverBuiltDependencies": [
      "obsbot-sdk"
    ]
  }
}
